# Motorola milanf - NetHunter Build B2
# Adds external USB wireless adapter support to B1.
# Preserve stock Qualcomm Wi-Fi and Motorola hardware drivers.

# Atheros AR9271
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=y

# Ralink RT5370 / RT5572
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y

# MediaTek MT7612U
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=y
CONFIG_MT76_USB=y
CONFIG_MT76x2U=y
